// Firestore security rules for Student Driver Log.
//
// These are published manually through the Firebase console (Firestore →
// Rules); this file is the version-controlled source of truth for what
// should be there. Keep the two in sync — edit here, then paste.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isSharedWithMe(studentData) {
      return studentData.sharedWithEmails is list && myEmail() in studentData.sharedWithEmails;
    }

    // The student reading their own dashboard. studentLoginEmail is present
    // only when the owner has explicitly turned student access on for that
    // student (Manage students → "Let this student sign in"), and holds the
    // address it was granted to. One field carries both facts, so this is a
    // single equality check — and the discovery query below needs only a
    // single-field index rather than a composite one.
    //
    // Deliberately NOT derived from the student's `email` field: that address
    // is on file for progress emails, and an owner typo there would otherwise
    // silently hand a stranger read access to a minor's full drive history.
    // Access has to be turned on deliberately.
    //
    // email_verified is required here and nowhere else. This is the one path
    // where access is granted purely on the basis of an address someone typed
    // into a form, so proof that the holder controls that inbox is the whole
    // security model. Google sign-ins arrive verified; email/password ones
    // verify via the link sent at sign-up.
    function isStudentSelf(studentData) {
      return studentData.studentLoginEmail is string &&
        studentData.studentLoginEmail == myEmail() &&
        request.auth.token.email_verified == true;
    }

    // ---------------------------------------------------------------------
    // emailPreferences/{email} -> { weeklyEmailOptOut, updatedAt }
    //
    // Reachable without a signed-in session on purpose: the unsubscribe link
    // in a progress email has to work for whoever received it, and the
    // recipient may not have an account at all.
    //
    // get() stays open for that. list() does NOT — the document IDs here are
    // email addresses, so an open list let anyone dump every address that has
    // ever set a preference. Nothing in the app lists this collection; both
    // callers read a single known doc (src/utils/emailPreferences.js).
    //
    // Writes are pinned to exactly the two fields the app writes, with the
    // right types, so this can't be used as free unauthenticated storage.
    // updatedAt is length-capped as well: the app writes an ISO timestamp
    // (24 chars, see src/utils/emailPreferences.js), and without a cap the
    // field would accept up to a megabyte of arbitrary data per document.
    // The cap bounds what one document can hold; it does not bound how many
    // documents an anonymous caller can create, which is the same gap the
    // note below describes and needs the same fix.
    //
    // Residual, accepted for now: anyone who knows an address can still
    // toggle that address's preference. Closing that needs a signed token in
    // the unsubscribe URL, which is a code change, not a rules change.
    //
    // Delete is narrower than write on purpose. Account deletion removes the
    // document so the address isn't left on file, but only the signed-in
    // owner of that address may do it — an open delete would let anyone clear
    // someone's opt-out and quietly resubscribe them.
    // ---------------------------------------------------------------------
    match /emailPreferences/{email} {
      allow get: if true;
      allow list: if false;
      allow create, update: if
        request.resource.data.keys().hasOnly(['weeklyEmailOptOut', 'updatedAt']) &&
        request.resource.data.weeklyEmailOptOut is bool &&
        request.resource.data.updatedAt is string &&
        request.resource.data.updatedAt.size() < 40;
      allow delete: if signedIn() && email == myEmail();
    }

    // ---------------------------------------------------------------------
    // studentDirectory/{sha256(email)}
    //   -> { studentId, ownerId, ownerName, firstName, lastName, email }
    //
    // Minimal cross-account record backing the "does a dashboard for this
    // email already exist?" check, so that lookup doesn't need read access to
    // the full student documents.
    //
    // create/update/delete are split apart deliberately. The previous single
    // `allow write: if signedIn() && request.resource.data.ownerId == request.auth.uid`
    // only inspected the INCOMING data, never the existing document — so any
    // signed-in user could overwrite anyone's directory entry by setting
    // ownerId to themselves, taking over the entry and redirecting future
    // access requests for that student to themselves. Update and delete now
    // check the stored owner as well.
    //
    // Documents are keyed by a SHA-256 of the student's email, so the
    // duplicate-email check is a direct read of one known document. That is
    // what lets `list` be denied: rules cannot inspect a query's filters, so
    // back when the check ran a where('email','==') query, permitting it meant
    // permitting the whole collection to be read out — any signed-in user
    // could enumerate every student's name and email.
    //
    // `get` stays open to signed-in users; finding an entry now requires
    // already knowing the address it was derived from.
    // ---------------------------------------------------------------------
    match /studentDirectory/{emailHash} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn() &&
        resource.data.ownerId == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // accessRequests/{requestId}
    //
    // One pending request per "let me see this student's dashboard" ask.
    // ownerId is verified rather than trusted from the client, so a request
    // can't be aimed at an account that doesn't actually own the student.
    // That check now reads the student document directly — proving the
    // student really does live under the claimed owner's account — instead
    // of going through studentDirectory, whose keys are no longer studentIds.
    // (get()/exists() inside rules are evaluated with full access, so this
    // works even though the requester can't read that student themselves.)
    //
    // The requester's identity was already pinned to their own uid/email,
    // which is what makes it safe for approveRequest() to grant access to
    // the address stored here; update stays closed so it can't be swapped
    // after the owner sees it.
    // ---------------------------------------------------------------------
    match /accessRequests/{requestId} {
      allow create: if signedIn() &&
        request.resource.data.requesterId == request.auth.uid &&
        request.resource.data.requesterEmail == myEmail() &&
        request.resource.data.status == 'pending' &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.ownerId)/students/$(request.resource.data.studentId));
      allow read, delete: if signedIn() &&
        (request.auth.uid == resource.data.ownerId || request.auth.uid == resource.data.requesterId);
      allow update: if false;
    }

    // ---------------------------------------------------------------------
    // users/{ownerId}/students/{studentId} and their logs
    //
    // Owner has full control; anyone the student is shared with can read the
    // student and read/write its drive logs, but can't edit or delete the
    // student itself. The added ownerId check on writes keeps a student
    // document from claiming an owner other than the account it lives under —
    // the client reads that field to build log paths.
    // ---------------------------------------------------------------------
    match /users/{ownerId}/students/{studentId} {
      allow read: if signedIn() &&
        (request.auth.uid == ownerId ||
         isSharedWithMe(resource.data) ||
         isStudentSelf(resource.data));
      allow create, update: if signedIn() &&
        request.auth.uid == ownerId &&
        request.resource.data.ownerId == ownerId;
      allow delete: if signedIn() && request.auth.uid == ownerId;

      // read and write are split apart here, where they used to be a single
      // `allow read, write`. The student themselves gets read and nothing
      // else: their dashboard is view-only, and that has to be enforced here
      // rather than by hiding buttons, since anyone can call Firestore
      // directly. Owner and shared co-parents keep full read/write.
      match /logs/{logId} {
        allow read: if signedIn() &&
          (request.auth.uid == ownerId ||
           isSharedWithMe(get(/databases/$(database)/documents/users/$(ownerId)/students/$(studentId)).data) ||
           isStudentSelf(get(/databases/$(database)/documents/users/$(ownerId)/students/$(studentId)).data));
        allow write: if signedIn() &&
          (request.auth.uid == ownerId ||
           isSharedWithMe(get(/databases/$(database)/documents/users/$(ownerId)/students/$(studentId)).data));
      }
    }

    // Inlined (not routed through isSharedWithMe()) because Firestore's
    // list/collection-group query validator can't statically prove a rule
    // matches the query's array-contains filter when the check is hidden
    // inside a function call — it denies the whole query rather than risk
    // it. The direct path-specific rule above doesn't have this constraint
    // (get() requests evaluate fully dynamically), so it can keep using
    // the helper.
    match /{path=**}/students/{studentId} {
      allow read: if signedIn() && myEmail() in resource.data.sharedWithEmails;
    }

    // Second collection-group rule, for the student finding their own
    // dashboard. Kept as its own match block rather than OR'd into the one
    // above: each collection-group query has to be statically matched to a
    // rule, and the two queries filter on different fields
    // (array-contains sharedWithEmails vs. == studentLoginEmail). Firestore
    // ORs allows across match statements, so both queries resolve while
    // neither grants more than its own filter.
    //
    // Needs a single-field index on students.studentLoginEmail with
    // collection-group scope — collection-group queries are not covered by
    // the automatic single-field indexes.
    match /{path=**}/students/{studentId} {
      allow read: if signedIn() &&
        resource.data.studentLoginEmail == myEmail() &&
        request.auth.token.email_verified == true;
    }

    // ---------------------------------------------------------------------
    // invitations/{invitationId}
    //
    // Write-only queue drained by scripts/send-invitation-emails.js with the
    // admin SDK, which bypasses these rules. Fields are pinned so a client
    // can't pre-set emailSent or attach extra payload to a queued email.
    // The content of that email is user-controlled by design (owner and
    // student names); it is escaped at render time in
    // src/utils/invitations.js, which is what keeps it from carrying markup.
    //
    // The owner can read and delete their own queued invitations so that
    // deleting a student takes its pending invitations with it, rather than
    // leaving records naming the student and the recipient's address behind.
    // Scoped to resource.data.ownerId, which is also what makes the
    // owner-filtered query the cleanup runs a valid list.
    // ---------------------------------------------------------------------
    match /invitations/{invitationId} {
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerEmail == request.auth.token.email &&
        request.resource.data.email is string &&
        request.resource.data.emailSent == false &&
        request.resource.data.keys().hasOnly([
          'email', 'studentId', 'studentName', 'ownerId', 'ownerName',
          'ownerEmail', 'createdAt', 'emailSent'
        ]);
      allow read, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
